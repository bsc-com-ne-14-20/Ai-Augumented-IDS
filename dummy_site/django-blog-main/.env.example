# Django Blog + IDS Middleware — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-django-secret-key

# ── IDS Middleware (MW-006) ───────────────────────────────────────────────────
# Full URL of the Flask IDS backend analyse endpoint.
# Example: https://your-droplet-ip/api/v1/analyse
IDS_BACKEND_URL=https://your-ids-backend/api/v1/analyse

# Shared secret sent as X-IDS-API-Key header to authenticate with the backend.
# Must match the IDS_API_KEY configured on the Flask backend.
IDS_API_KEY=replace-with-32-char-random-secret

# Optional: override the default 500ms timeout for IDS backend calls (in seconds).
# IDS_TIMEOUT=0.5

# Optional: number of background worker threads for IDS forwarding (default: 4).
# IDS_MAX_WORKERS=4
