# AA-IDS Environment Variables
# Copy this file to .env and fill in actual values. Never commit .env to version control.

# ── Django Middleware (Render) ────────────────────────────────────────────────
IDS_BACKEND_URL=https://your-digitalocean-droplet-ip/api/v1/analyse
IDS_API_KEY=replace-with-32-char-random-secret

# ── Flask IDS Backend (DigitalOcean) ──────────────────────────────────────────
FLASK_SECRET_KEY=replace-with-flask-secret
FLASK_DEBUG=false
PORT=5000

# API Authentication (must match IDS_API_KEY above)
# IDS_API_KEY=replace-with-32-char-random-secret

# ML Model Paths
ML_MODEL_PATH=models/rf_model.joblib
ML_SCALER_PATH=data/final/scaler.pkl
ML_FEATURE_NAMES_PATH=data/final/feature_names.txt
ML_CONFIDENCE_THRESHOLD=0.65

# Rule Engine Configuration
RULE_ENGINE_THRESHOLD=5
BF_REQUEST_THRESHOLD=10
BF_TIME_WINDOW_SECONDS=60

# Database (SQLite for prototype, PostgreSQL for production)
DB_PATH=ids.db

# CORS Origins (comma-separated)
SOCKETIO_CORS_ORIGINS=*

# API Limits
MAX_LOGS_PER_REQUEST=5000
DEFAULT_PAGE_SIZE=50

# ── Flutter Dashboard (Netlify) ───────────────────────────────────────────────
FLASK_BASE_URL=https://your-digitalocean-droplet-ip
FLASK_WS_URL=wss://your-digitalocean-droplet-ip/ws

GROQ_API_KEY=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
DATABASE_URL=postgresql://ids_user:ids_password@localhost:5432/aa_ids
SECRET_KEY=aa-ids-secret-2024
