# AA-IDS Environment Variables — copy to .env and fill in values. Never commit .env.
IDS_BACKEND_URL=https://your-digitalocean-droplet-ip
IDS_API_KEY=replace-with-shared-secret
RF_MODEL_PATH=/path/to/random_forest_model.pkl
XGB_MODEL_PATH=/path/to/xgboost_model.pkl
FLASK_WS_URL=wss://ids.example.com/ws
DJANGO_SECRET_KEY=replace-with-django-secret 